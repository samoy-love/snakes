# ---------------------------------------------------------------------------
# Snakes — пример конфигурации. Скопируйте в .env и отредактируйте:
#   cp .env.example .env
# Файл .env в git не коммитится (см. .gitignore).
#
# Значения ниже — рабочие для локального `go run .`. Единственное, что
# обязательно поменять перед продом, — PROFILE_SECRET.
# ---------------------------------------------------------------------------

# ------------------------------ Сам сервер ---------------------------------
# Порт HTTP/WS сервера. По умолчанию 3000.
# Наружу не публикуется: перед ним стоит nginx, он и держит 443.
PORT=3000

# Интерфейс, на котором сервер слушает. По умолчанию 127.0.0.1 — так безопасен
# прод-вариант, где бинарь запущен через systemd за СИСТЕМНЫМ nginx: сам процесс
# снаружи недоступен, и весь трафик обязан пройти через nginx с его лимитами,
# проверкой origin и заголовками безопасности.
#
# Выкатка через deploy-kit держит игру на loopback, а наружу её отдаёт nginx
# того же хоста. Менять переменную здесь имеет смысл, только если вы запускаете бинарь
# напрямую и хотите пустить к нему кого-то, кроме локального nginx.
BIND_ADDR=127.0.0.1

# Максимум ЖИВЫХ игроков в одной комнате (боты считаются отдельно).
# По умолчанию 16. Значение <= 0 игнорируется.
ROOM_LIMIT=16

# Длительность матча в тиках. Тик = 100 мс, то есть 3000 тиков = 5 минут.
MATCH_DURATION_TICKS=3000

# Пауза между матчами в тиках. Дефолт в коде — 150 (15 секунд).
MATCH_INTERMISSION_TICKS=150

# Список origin'ов, с которых разрешено WebSocket-рукопожатие (через запятую).
# Если переменная пуста, сервер уходит в прод-дефолт
# http(s)://snakes.samoy.love и отвечает 403 на /ws со всех остальных хостов.
#
# ВАЖНО (проверено вживую): библиотека github.com/coder/websocket дополнительно
# сверяет Origin с заголовком Host и при несовпадении сама отдаёт 403 ещё до
# того, как отработает этот список. Практический вывод — origin обязан
# совпадать с тем host:port, по которому клиент реально открывает страницу.
WS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Пропускать ли loopback-origin (http://localhost, http://127.0.0.1:*) МИМО
# списка WS_ORIGINS. Дефолт в коде — включено (удобно в разработке).
#
# В ПРОДЕ ОБЯЗАТЕЛЬНО 0. Иначе любая страница, открытая у игрока на его же
# машине (локальный дев-сервер, установленная малварь, любой софт, поднявший
# http-сервер на 127.0.0.1), присылает Origin: http://localhost и проходит
# проверку — allowlist перестаёт что-либо значить.
#
# Выключается значениями 0, false, no, off; всё остальное = включено.
# Проверить фактическое состояние можно по логу старта: wsAllowLocalhost=...
WS_ALLOW_LOCALHOST=0

# ---------------------------------------------------------------------------
# !!! ОБЯЗАТЕЛЬНО ЗАДАТЬ В ПРОДЕ !!!
#
# PROFILE_SECRET — HMAC-ключ, которым подписываются токены личности игрока.
# Если переменная НЕ задана, сервер генерирует случайный эфемерный ключ при
# каждом старте. Последствия: после любого рестарта/редеплоя ВСЕ выданные
# токены становятся невалидными, игроки получают новые profile id, и весь
# прогресс (баланс «Стиля», купленная косметика, дейлики, ачивки) фактически
# теряется — старые профили остаются в файле мёртвым грузом и через 90 дней
# вычищаются по TTL.
#
# Прод намеренно НЕ стартует, если переменная пуста.
#
# Сгенерировать: openssl rand -base64 48
# Менять секрет = разлогинить всех игроков. Храните его как секрет CI/сервера.
# ---------------------------------------------------------------------------
PROFILE_SECRET=

# Путь к файлу профилей. Дефолт в коде — ./data/profiles.json относительно
# рабочей директории. На проде — /var/lib/snakes/profiles.json: этот
# каталог переживает выкатку, в отличие от каталога релиза, и его же
# снимает systemd-таймер snakes-backup-profiles.timer.
PROFILES_PATH=/var/lib/snakes/profiles.json

# Список доверенных прокси (CIDR или голые IP, через запятую).
# X-Forwarded-For учитывается ТОЛЬКО если непосредственный пир входит в этот
# список; иначе клиентский IP берётся из TCP-соединения.
#
# Значение должно совпадать с адресом, с которого приходит nginx (на одном
# хосте — loopback). Список намеренно узкий: широкий (например все диапазоны
# RFC1918) приводит к тому, что IP игрока из локальной сети тоже считается
# «доверенным прокси», цепочка X-Forwarded-For исчерпывается и в rate-limit
# все игроки попадают в одну корзину под адресом nginx-контейнера.
# По умолчанию в коде: 127.0.0.1/8,::1
TRUSTED_PROXIES=127.0.0.1/8,::1,172.28.0.0/16

# Потолок числа одновременно живущих комнат. Комната стоит ~500 КБ, дефолт в
# коде — 64. Значение <= 0 или нечисловое игнорируется.
MAX_ROOMS=64

# Потолок числа профилей в сторе. saveProfiles копирует и маршалит ВЕСЬ набор
# целиком, поэтому число ограничено. Дефолт в коде — 50000.
MAX_PROFILES=50000

# Через сколько часов вычищается профиль БЕЗ прогресса (зашёл, ничего не
# заработал, ушёл). Дефолт в коде — 6. Профили с прогрессом живут 90 дней и
# этой переменной не управляются.
PROFILE_EMPTY_TTL_HOURS=6

# Отладка ботов: 1 — включает мгновенный «снап» бота при смерти.
# В проде оставьте пустым.
BOT_DEATH_SNAP=
