# ---------------------------------------------------------------------------
# Snakes — пример конфигурации. Скопируйте в .env и отредактируйте:
#   cp .env.example .env
# Файл .env в git не коммитится (см. .gitignore).
# ---------------------------------------------------------------------------

# Порт HTTP/WS сервера. По умолчанию 3000.
# В docker compose наружу порт не публикуется — только внутрь сети к nginx.
PORT=3000

# Максимум ЖИВЫХ игроков в одной комнате (боты считаются отдельно).
# По умолчанию 16. Значение <= 0 игнорируется.
ROOM_LIMIT=16

# Длительность матча в тиках. Тик = 100 мс, то есть 3000 тиков = 5 минут.
MATCH_DURATION_TICKS=3000

# Пауза между матчами в тиках (300 = 30 секунд).
MATCH_INTERMISSION_TICKS=300

# ---------------------------------------------------------------------------
# !!! ОБЯЗАТЕЛЬНО ЗАДАТЬ В ПРОДЕ !!!
#
# PROFILE_SECRET — HMAC-ключ, которым подписываются токены личности игрока.
# Если переменная НЕ задана, сервер генерирует случайный эфемерный ключ при
# каждом старте. Последствия: после любого рестарта/редеплоя ВСЕ выданные
# токены становятся невалидными, игроки получают новые profile id, и весь
# прогресс (баланс «Стиля», купленная косметика, дейлики, ачивки) фактически
# теряется — старые профили остаются в файле мёртвым грузом и через 90 дней
# вычищаются по TTL.
#
# Сгенерировать: openssl rand -base64 48
# Менять секрет = разлогинить всех игроков. Храните его как секрет CI/сервера.
# ---------------------------------------------------------------------------
PROFILE_SECRET=

# Путь к файлу профилей. По умолчанию ./data/profiles.json.
# В образе каталог /app/data объявлен как VOLUME — не меняйте путь, если
# используете штатный docker compose, иначе прогресс не переживёт пересоздание
# контейнера.
PROFILES_PATH=/app/data/profiles.json

# Список доверенных прокси (CIDR или голые IP, через запятую).
# X-Forwarded-For учитывается ТОЛЬКО если непосредственный пир входит в этот
# список; иначе клиентский IP берётся из TCP-соединения. Для docker compose
# укажите подсеть внутренней сети, иначе rate-limit будет считать всех
# игроков одним IP-адресом nginx-контейнера.
# По умолчанию: 127.0.0.1/8,::1
TRUSTED_PROXIES=127.0.0.1/8,::1,172.16.0.0/12

# Отладка ботов: 1 — включает мгновенный «снап» бота при смерти.
# В проде оставьте пустым.
BOT_DEATH_SNAP=
