# ---------------------------------------------------------------------------
# Snakes — пример конфигурации. Скопируйте в .env и отредактируйте:
#   cp .env.example .env
# Файл .env в git не коммитится (см. .gitignore).
#
# Значения ниже — рабочие для локального `docker compose up -d --build`
# (проверено вживую). Единственное, что обязательно поменять перед продом, —
# PROFILE_SECRET.
# ---------------------------------------------------------------------------

# --------------------------- Только для compose ----------------------------
# Порт, на котором nginx-контейнер публикуется на хост: http://localhost:8080.
# Читается docker-compose.yml, самим сервером НЕ используется.
# Если 8080 на машине занят — поменяйте здесь И в WS_ORIGINS ниже, иначе
# WebSocket-рукопожатие будет отклоняться с 403.
HTTP_PORT=8080

# ------------------------------ Сам сервер ---------------------------------
# Порт HTTP/WS сервера внутри контейнера. По умолчанию 3000.
# В docker compose наружу он не публикуется — только внутрь сети к nginx.
PORT=3000

# Максимум ЖИВЫХ игроков в одной комнате (боты считаются отдельно).
# По умолчанию 16. Значение <= 0 игнорируется.
ROOM_LIMIT=16

# Длительность матча в тиках. Тик = 100 мс, то есть 3000 тиков = 5 минут.
MATCH_DURATION_TICKS=3000

# Пауза между матчами в тиках. Дефолт в коде — 150 (15 секунд).
MATCH_INTERMISSION_TICKS=150

# Список origin'ов, с которых разрешено WebSocket-рукопожатие (через запятую).
# Если переменная пуста, сервер уходит в прод-дефолт
# http(s)://snakes.samoy.love и отвечает 403 на /ws со всех остальных хостов.
#
# ВАЖНО (проверено вживую): библиотека nhooyr.io/websocket дополнительно
# сверяет Origin с заголовком Host и при несовпадении сама отдаёт 403 ещё до
# того, как отработает этот список. Практический вывод — origin обязан
# совпадать с тем host:port, по которому клиент реально открывает страницу.
WS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# !!! ОБЯЗАТЕЛЬНО ЗАДАТЬ В ПРОДЕ !!!
#
# PROFILE_SECRET — HMAC-ключ, которым подписываются токены личности игрока.
# Если переменная НЕ задана, сервер генерирует случайный эфемерный ключ при
# каждом старте. Последствия: после любого рестарта/редеплоя ВСЕ выданные
# токены становятся невалидными, игроки получают новые profile id, и весь
# прогресс (баланс «Стиля», купленная косметика, дейлики, ачивки) фактически
# теряется — старые профили остаются в файле мёртвым грузом и через 90 дней
# вычищаются по TTL.
#
# docker-compose.yml намеренно НЕ стартует, если переменная пуста.
#
# Сгенерировать: openssl rand -base64 48
# Менять секрет = разлогинить всех игроков. Храните его как секрет CI/сервера.
# ---------------------------------------------------------------------------
PROFILE_SECRET=

# Путь к файлу профилей. Дефолт в коде — ./data/profiles.json относительно
# рабочей директории; в образе переменная выставлена в /app/data/profiles.json.
# Каталог /app/data монтируется именованным volume snakes_data (см.
# docker-compose.yml) — именно он и обеспечивает сохранение прогресса между
# пересозданиями контейнера. VOLUME в Dockerfile НЕ объявлен намеренно, чтобы
# `docker run` без -v не плодил анонимные тома.
PROFILES_PATH=/app/data/profiles.json

# Список доверенных прокси (CIDR или голые IP, через запятую).
# X-Forwarded-For учитывается ТОЛЬКО если непосредственный пир входит в этот
# список; иначе клиентский IP берётся из TCP-соединения.
#
# Значение должно совпадать с subnet сети snakes_net из docker-compose.yml
# (172.28.0.0/16). Список намеренно узкий: широкий (например все диапазоны
# RFC1918) приводит к тому, что IP игрока из локальной сети тоже считается
# «доверенным прокси», цепочка X-Forwarded-For исчерпывается и в rate-limit
# все игроки попадают в одну корзину под адресом nginx-контейнера.
# По умолчанию в коде: 127.0.0.1/8,::1
TRUSTED_PROXIES=127.0.0.1/8,::1,172.28.0.0/16

# Отладка ботов: 1 — включает мгновенный «снап» бота при смерти.
# В проде оставьте пустым.
BOT_DEATH_SNAP=
