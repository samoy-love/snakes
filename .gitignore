node_modules/
package-lock.json
# public/ намеренно без npm-зависимостей: игра грузится браузером как есть.
# Правило осталось со времён, когда JS-манифестов в проекте не было вовсе.
package.json
# Исключение: манифест офлайн-оснастки. Без него из свежего клона нельзя
# запустить npm i в tools/, то есть визуальный стенд и замеры недоступны.
!tools/package.json
.DS_Store
Thumbs.db
*.log
*.tmp
*.exe
*.dll
*.so
*.dylib
*.out
*.test

# Данные рантайма: профили игроков (PROFILES_PATH)
data/

# Локальная конфигурация с секретами (шаблон — .env.example)
.env

# Скомпилированные бинари и артефакты сборки
snakes
snakes.exe
dist/

# Каталог сборки для выкатки (deploy-kit)
stage/

# Рабочее дерево общего deploy-kit: отдельный репозиторий, не подмодуль
.wt-packages/
