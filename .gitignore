node_modules/
package-lock.json
# public/ намеренно без npm-зависимостей: игра грузится браузером как есть.
# Правило осталось со времён, когда JS-манифестов в проекте не было вовсе.
package.json
# Исключение: манифест офлайн-оснастки. Без него из свежего клона нельзя
# запустить npm i в tools/, то есть визуальный стенд и замеры недоступны.
!tools/package.json
# Исключение: единственная JS-зависимость проекта — Playwright для
# tests/visual (см. docs/testing.md). package-lock.json нужен закоммиченным,
# иначе npm ci в CI ставит версии заново на каждый прогон и кэш браузеров
# (ключ — хэш лока) никогда не попадает.
!tests/visual/package.json
!tests/visual/package-lock.json

# Playwright: результаты прогонов и одноразовые профили визуального сервера
# (PROFILES_PATH из make run-visual) — рантайм-мусор, не артефакт.
tests/visual/test-results/
tests/visual/.tmp/
tests/visual/playwright-report/
# catalog.spec.mjs: обычные скриншоты для ревью (docs/reviews/), не эталоны —
# те отдельно в tests/visual/screens.spec.mjs-snapshots/. Регенерируются
# прогоном, коммитить нечего.
tests/visual/shots/
.DS_Store
Thumbs.db
*.log
*.tmp
*.exe
*.dll
*.so
*.dylib
*.out
*.test

# Данные рантайма: профили игроков (PROFILES_PATH)
data/

# Локальная конфигурация с секретами (шаблон — .env.example)
.env

# Скомпилированные бинари и артефакты сборки
snakes
snakes.exe
dist/

# Каталог сборки для выкатки (deploy-kit)
stage/

# Рабочее дерево общего deploy-kit: отдельный репозиторий, не подмодуль
.wt-packages/

# Локальная оснастка Claude Code: планы, воркtree-агенты, личные настройки.
.claude/
