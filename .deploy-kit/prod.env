# Описание цели выкатки snakes.samoy.love.
# Читают и CI (reusable workflow go-service из deploy-kit), и локальный
# `deploy-kit/bin/deploy --config .deploy-kit/prod.env`.

APP=snakes
ROOT=/opt/snakes
ARTIFACT_DIR=stage
UNIT=snakes.service

# Файлы читает www-data — под ним работает юнит.
OWNER=root:www-data

# Сервер на Oracle Ampere: aarch64. Раннер amd64, поэтому кросс-сборка.
GOARCH=arm64

# Клиент едет ОДНИМ артефактом с сервером. У них общий бинарный протокол на
# 21 тип событий: разъехавшиеся версии ломают разбор пакетов у игроков,
# причём молча — страница откроется, а игра развалится.
# Кавычки ОДИНАРНЫЕ: строка выполняется позже, уже с заданными DEPLOY_VERSION
# и DEPLOY_GOARCH. В двойных кавычках подстановка случилась бы при чтении
# этого файла — когда переменных ещё нет, — и в бинарь уехало бы version=dev.
# Плейсхолдер __BUILD__ в public/index.html заменяется на идентификатор релиза
# в КОПИИ, которая уезжает на сервер, — в репозитории литерал остаётся.
# Без этой замены все выкатки отдают клиент по одному и тому же URL, браузер
# держит старую версию из кэша, а протокол у клиента и сервера общий: старый
# клиент против нового сервера ломает разбор пакетов молча.
#
# Последним шагом в артефакт кладутся юниты systemd. Каталог копируется
# ЦЕЛИКОМ (`cp -r deploy/systemd stage/systemd`), а не пофайлово: рядом с
# плоскими `snakes-backup-profiles.{service,timer}` лежит `snakes.service.d/`
# с дополнением к юниту, и плоское копирование потеряло бы подкаталог.
# Раскладка внутри `systemd/` — ровно та, которую разбирает install_units из
# deploy-kit: `*.service`, `*.timer`, `*.socket` в корне и `<юнит>.d/*.conf`
# в подкаталоге. Всё, что в эту раскладку не попало, выкатка называет вслух
# и не ставит, поэтому новый файл в deploy/systemd/ доедет сам, а опечатка в
# имени будет видна в логе, а не молча проигнорирована.
#
# До этого шага ни один из трёх файлов на сервер не уезжал вовсе: правка юнита
# в git не меняла на машине ничего, а выкатка при этом была зелёной. С этого
# момента копия из репозитория становится главной и перезаписывает хостовую.
BUILD_CMD='rm -rf stage && mkdir -p stage && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=${DEPLOY_VERSION:-dev} -X main.Commit=$(git rev-parse HEAD) -X main.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" -o stage/snakes . && cp -r public stage/public && grep -rlZ "__BUILD__" stage/public | xargs -0 -r sed -i "s/__BUILD__/${DEPLOY_VERSION:-dev}/g" && cp -r deploy/systemd stage/systemd'

HEALTH=https://snakes.samoy.love/healthz
VERSION_URL=https://snakes.samoy.love/version.json

NEIGHBOURS=samoy.love,metro.samoy.love,launcher.samoy.love,status.samoy.love

KEEP=5

# Конфиг nginx snakes.samoy.love. Пара, а не две отдельные настройки: и CI, и
# `dk deploy` возят конфиг, только когда заданы ОБА ключа. Одна половина без
# другой — не «настроено наполовину», а молча пропущенный шаг: выкатка зелёная,
# правки в конфиге не уезжают никуда и никогда. Именно так у соседних целей
# годами стоял один NGINX_DEST, ничего не применяя. Правите один ключ — правьте
# второй.
#
# Путь считается ВНУТРИ deploy-kit: конфигурация nginx живёт только там, копий
# в проектных репозиториях не держим (CLAUDE.md). Файл приезжает оттуда же,
# откуда и проверяющий его ci/nginx-check.sh, — из main.
#
# Раньше эти ключи здесь были бы мертвы независимо от значения: snakes катится
# через go-service.yml, а он до deploy-kit#35 не умел возить конфиг вообще.
NGINX_CONF=nginx/sites/snakes.conf
NGINX_DEST=/etc/nginx/sites-available/snakes.conf

# NGINX_RELOAD здесь НЕ ставится, хотя у metro стоит, — разница не в
# недосмотре, а в типе цели. У статики nginx сам раздаёт каталог, и reload
# после переключения симлинка ей обязателен. Здесь каталог отдаёт юнит,
# nginx только проксирует на 127.0.0.1:8090, и свой reload он получает раньше
# и от другого — от nginx-apply.sh, вместе с nginx -t, бэкапом и откатом.
# go-service.yml этот ключ не читает вовсе. На локальном пути он бы добавил
# второй reload после переключения симлинка и, что хуже, привязал бы откат
# релиза snakes к состоянию nginx: посторонняя поломка в чужом конфиге на этом
# же хосте валила бы nginx -t и откатывала бы исправную выкатку.

# О релизе объявляет бот samoy-status, а не CI. Агент опрашивает
# /version.json каждую минуту, видит смену версии и пишет в чат сам — поэтому
# сообщения приходят, хотя TELEGRAM_BOT_TOKEN задан ровно в одном репозитории
# из шести. Если завести токен и здесь, на каждый релиз придёт ДВА сообщения
# об одном и том же. Голос остаётся один — бот, а выкатка молчит осознанно.
# Молчание задаётся здесь, а не отсутствием секрета: пустой секрет пайплайн
# считает недосмотром и ругается предупреждением «о релизе никто не узнал».
# NOTIFY=never он проверяет РАНЬШЕ токена, поэтому предупреждения не будет.
NOTIFY=never

# Профили игроков лежат в /var/lib/snakes/profiles.json — ВНЕ каталога
# релизов, поэтому выкатка их не касается. Это единственная копия прогресса
# всех игроков; за её сохранность отвечает отдельный таймер бэкапов.

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки. BUILD_CMD выше для
# этого не годится в принципе: в нём GOOS=linux GOARCH=arm64, и локально он
# даёт ELF под aarch64, который на машине разработчика не запустится.
RUN_CMD="go run ."

# Статика раздаётся из ./public ОТНОСИТЕЛЬНО рабочего каталога, поэтому
# запуск идёт из корня репозитория — RUN_DIR не задан намеренно.
RUN_PORT=3000
RUN_HEALTH=/healthz

# WS_ALLOW_LOCALHOST=1 — НЕ УДОБСТВО, А УСЛОВИЕ ТОГО, ЧТО ИГРА ВООБЩЕ РАБОТАЕТ.
#
# Пустой WS_ORIGINS означает не «origin не проверяется», а «разрешён только
# свой» — и рукопожатие /ws с http://localhost:3000 получает 403. Страница при
# этом открывается полностью: меню, профиль, всё на месте, — и не соединяется.
# Выглядит как поломка игры, а не как настройка, поэтому переменная стоит
# здесь, а не в голове у запускающего.
#
# В прод она не уезжает: этот ключ читает только `dk run`, а на сервере
# окружение задаёт systemd-юнит. Там она и не нужна — там WS_ORIGINS заполнен.
RUN_ENV="PORT=%PORT%;WS_ALLOW_LOCALHOST=1"

# Профили лягут в ./data/profiles.json рядом с репозиторием — это дефолт кода,
# и трогать его локально незачем.
